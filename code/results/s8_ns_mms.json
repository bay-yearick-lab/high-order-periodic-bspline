{
  "problem": "2D Taylor-Green vortex, exact periodic incompressible Navier-Stokes",
  "exact_solution": {
    "u": "-cos(km x) sin(km y) exp(-2 km^2 nu t)",
    "v": "sin(km x) cos(km y) exp(-2 km^2 nu t)",
    "p": "-(cos 2km x + cos 2km y) exp(-4 km^2 nu t)/4",
    "km": 2,
    "domain": "[0,2pi]^3, z-invariant, w=0"
  },
  "forced_mms": {
    "psi": "[sin(x+0.7) sin(y+0.3) + 0.5 sin(2x+0.2) sin(y+0.9)] cos(t)",
    "u": "dpsi/dy",
    "v": "-dpsi/dx",
    "w": "0 (z-invariant)",
    "source": "S = u_t + (u.grad)u - nu lap(u); p_m = 0, the discrete projection determines the discrete pressure; source added per RK stage at times t, t+dt, t+dt/2",
    "generator": "code/generate_mms_forcing.py (sympy; symbolic checks: div u == 0, forced residual == 0, convective term not a gradient; C-vs-sympy at 20 random points < 1.2e-15)"
  },
  "Tend": 1.0,
  "dt_policy": "per (regime, scheme, grid): cubed SSP-RK3 time error at least two orders below the scheme's measured spatial error, capped by advective CFL sigma<=0.3; verified by step halving (dt_halving_checks)",
  "grids": [
    16,
    32,
    64
  ],
  "error_norm": "velocity L2 (mean-square density) and Linf vs exact field at t=Tend",
  "floor_convention": "floored = error at the round-off plateau (no decrease under refinement); no slope is fit through floored points",
  "design_order_note": "composite_order = direct-second-derivative order 2*floor(p/2) for BMC (the viscous Laplacian uses D^(2)), FD order for C6/C8; d1_order = nodal first-derivative order 2*ceil(p/2)",
